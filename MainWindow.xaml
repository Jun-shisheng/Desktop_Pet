<Window x:Class="DeepSeekFishPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepSeek 大肥鱼桌宠"
        Width="180" Height="220"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        Focusable="False">
    <Grid x:Name="RootGrid" Width="180" Height="220"
          Background="{x:Null}" ClipToBounds="False"
          PreviewMouseLeftButtonDown="Pet_MouseLeftButtonDown"
          PreviewMouseLeftButtonUp="Pet_MouseLeftButtonUp"
          PreviewMouseMove="Pet_MouseMove">
        <Grid x:Name="CharacterVisual" Width="180" Height="204"
              HorizontalAlignment="Center" VerticalAlignment="Bottom"
              IsHitTestVisible="False" RenderTransformOrigin="0.5,1">
            <!-- Shown only when no embedded PNG exists. -->
            <Canvas x:Name="FallbackArt" Width="180" Height="204">
                <Canvas.RenderTransform>
                    <TranslateTransform Y="7" />
                </Canvas.RenderTransform>
                <Ellipse Canvas.Left="40" Canvas.Top="190" Width="100" Height="9"
                         Fill="#3345739B" />
                <!-- A round blue fish with a tail and a bowl of white rice. -->
                <Path Data="M 41,105 C 24,96 13,79 15,63 C 30,73 40,82 53,92 Z"
                      Fill="#2386CB" Stroke="#155989" StrokeThickness="3" />
                <Path Data="M 42,119 C 24,126 15,141 18,158 C 34,148 44,140 53,131 Z"
                      Fill="#248ACF" Stroke="#155989" StrokeThickness="3" />
                <Path Data="M 88,59 C 91,45 99,37 107,34 C 109,48 115,55 123,62 Z"
                      Fill="#3096DB" Stroke="#155989" StrokeThickness="3" />
                <Ellipse Canvas.Left="32" Canvas.Top="56" Width="137" Height="127"
                         Fill="#2389D2" Stroke="#155989" StrokeThickness="4" />
                <Path Data="M 61,123 C 81,151 132,163 165,130 C 159,163 128,183 92,181 C 68,179 49,158 45,137 Z"
                      Fill="#E6F7FD" />
                <Path Data="M 59,135 C 48,141 42,154 47,168 C 60,163 69,153 75,145 Z"
                      Fill="#32A3E8" Stroke="#155989" StrokeThickness="3" />
                <Ellipse Canvas.Left="132" Canvas.Top="92" Width="9" Height="11" Fill="#173F61" />
                <Ellipse Canvas.Left="134" Canvas.Top="94" Width="3" Height="3" Fill="White" />
                <Ellipse Canvas.Left="143" Canvas.Top="108" Width="15" Height="8" Fill="#70C7ED" />
                <Path Data="M 140,123 Q 150,130 159,121" Fill="{x:Null}"
                      Stroke="#155989" StrokeThickness="2" StrokeStartLineCap="Round" />
                <Path Data="M 69,157 C 79,146 113,143 126,156 L 121,186 C 104,195 85,193 73,183 Z"
                      Fill="#F9FAF7" Stroke="#7D9EB7" StrokeThickness="3" />
                <Path Data="M 74,156 C 82,142 96,140 101,148 C 111,139 123,147 124,157 Z"
                      Fill="#FFFFFF" Stroke="#D8E4EA" StrokeThickness="2" />
                <Path Data="M 71,162 Q 98,174 126,161" Fill="{x:Null}"
                      Stroke="#7D9EB7" StrokeThickness="2" />
                <Path Data="M 118,146 C 124,136 133,132 142,135 C 140,146 133,153 126,158 Z"
                      Fill="#39A8E9" Stroke="#155989" StrokeThickness="3" />
            </Canvas>

            <!-- Embedded pose art is rendered above the vector fallback. -->
            <Image x:Name="SpriteImage" Width="180" Height="180"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                   Visibility="Collapsed" />

            <Image x:Name="ShortcutImage" Width="38" Height="38"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Margin="0,0,0,35" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Visibility="Collapsed" />
            <TextBlock x:Name="PropGlyph" FontFamily="Segoe UI Emoji" FontSize="30"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,40,6,0" Visibility="Collapsed" />
        </Grid>

        <Border x:Name="SpeechBubble" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                IsHitTestVisible="False" Margin="6,0,6,76" MaxWidth="150"
                Padding="6,4" CornerRadius="9"
                Background="#F9FFFFFF" BorderBrush="#AD6591B2" BorderThickness="1">
            <TextBlock x:Name="SpeechText" FontSize="11" Foreground="#233753"
                       TextWrapping="Wrap" TextAlignment="Center" />
        </Border>

        <Border x:Name="DeepSeekBalanceBadge" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                IsHitTestVisible="False" Margin="6,5,6,0" MaxWidth="165"
                Padding="5,2" CornerRadius="7"
                Background="#E6ECF8FD" BorderBrush="#996591B2" BorderThickness="1">
            <TextBlock x:Name="DeepSeekBalanceText" FontSize="10" Foreground="#233753"
                       TextWrapping="Wrap" TextAlignment="Center" />
        </Border>

        <!-- Only the small pet body accepts input; the rest of the drawing window is click-through. -->
        <Border x:Name="PetHitArea" Width="76" Height="84"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Background="Transparent" />

        <Grid x:Name="WhackVisual" Width="100" Height="100"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Visibility="Collapsed">
            <Image x:Name="WhackImage" Width="100" Height="100"
                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            <Border x:Name="WhackHud" HorizontalAlignment="Center"
                    VerticalAlignment="Bottom" Margin="0,0,0,10"
                    Padding="3,1" CornerRadius="5" Background="#C5233556"
                    IsHitTestVisible="False" Visibility="Collapsed">
                <TextBlock x:Name="WhackHudText" FontSize="10"
                           Foreground="White" FontWeight="Bold" />
            </Border>
        </Grid>
    </Grid>
</Window>
